#cloud-config
# Cloud-init userData for the Rocky Linux generic cloud image.
# Placeholders ({{HOSTNAME}}, {{PASSWORD}}) are substituted by nutanix_olla_vm.py
# before the document is base64-encoded into the VM guest customization payload.
hostname: {{HOSTNAME}}
fqdn: {{HOSTNAME}}
preserve_hostname: false

# Allow password SSH login with the requested credentials.
ssh_pwauth: true
disable_root: false

users:
  - name: rocky
    groups: [wheel]
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    shell: /bin/bash
    lock_passwd: false

chpasswd:
  expire: false
  list: |
    rocky:{{PASSWORD}}

# The generic cloud image ships a ~10 GiB root; grow it to fill the 50 GiB disk.
growpart:
  mode: auto
  devices: ['/']
resize_rootfs: true

package_update: true
packages:
  - curl
  - tar

runcmd:
  - [ systemctl, enable, --now, sshd ]
